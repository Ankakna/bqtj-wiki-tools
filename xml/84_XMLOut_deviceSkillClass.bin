<?xml version="1.0" encoding="utf-8" ?>
<data>
	<father name="deviceSkill" cnName="装置技能">
		
		<skill name="悬停沙漏">
			<name>timeCapsule</name>
			<cnName>悬停沙漏</cnName><noBeClearB>1</noBeClearB>
			<!--英雄技能属性------------------------------------------------------------ -->
			<cd>90</cd>
			<changeText>持续时间：[duration]秒</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>active</conditionType>
			<condition>no</condition>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>state</addType><stateType>time</stateType>
			<effectType>timeCapsule</effectType>
			<mul>1.5</mul>
			<duration>3</duration>
			<!--图像------------------------------------------------------------ -->
			<meEffectImg name="timeCapsule"/>
			<stateEffectImg name="timeCapsuleState"/>
			<description>让周围的时间停止下来，并增加子弹[mul-1]的伤害，期间无法使用副手，持续[duration]秒。期间再次按下装置键，或者使用载具、附身、变身类技能，则会结束时间停止。</description>
			<!-- 技能各等级 ------------------------------------------------------------ -->
			<growth>
				<skill><duration>3</duration></skill>
				<skill><duration>5</duration></skill>
				<skill><duration>7</duration></skill>
				<skill><duration>8.5</duration></skill>
			</growth>
		</skill>
		
		
		<skill name="悬停沙漏-任务专属">
			<name>timeCapsuleT</name>
			<cnName>悬停沙漏T</cnName>
			<!--英雄技能属性------------------------------------------------------------ -->
			<cd>2</cd>
			<changeText>持续时间：[duration]秒</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>active</conditionType>
			<condition>no</condition>
			<target>me</target>
			<!--效果------------------------------------------------------------ -->
			<addType>state</addType><stateType>time</stateType>
			<effectType>timeCapsule</effectType>
			<mul>1.5</mul>
			<duration>30</duration>
			<!--图像------------------------------------------------------------ -->
			<meEffectImg name="timeCapsule"/>
			<stateEffectImg name="timeCapsuleState"/>
			<description>让周围的时间停止下来，并增加枪支[mul-1]的伤害，持续[duration]秒。期间再次按下装置键，可结束时间停止。</description>
			<!-- 技能各等级 ------------------------------------------------------------ -->
			<growth>
				<skill><duration>5</duration></skill>
				<skill><duration>10</duration></skill>
				<skill><duration>15</duration></skill>
				<skill><duration>20</duration></skill>
				<skill><duration>30</duration></skill>
				<skill><duration>40</duration></skill>
			</growth>
		</skill>
		
		
		
		
		
		<skill index="0" name="地震"><!-- 生存-群体-主动 -->
			<name>earthquake</name>
			<cnName>地震</cnName>
			<!--英雄技能属性------------------------------------------------------------ -->
			<cd>60</cd>
			<changeText>持续时间：[duration]秒</changeText>
			<!--触发条件与目标------------------------------------------------------------ -->
			<conditionType>active</conditionType>
			<condition>avtiveSkillCdOver</condition>
			<otherConditionArr>nearAttackTarget</otherConditionArr>
			<conditionRange>300</conditionRange>
			<target>me,range,enemy</target>
			<!--效果------------------------------------------------------------ -->
			<addType>instantAndState</addType>
			<effectType>dizziness</effectType>
			<duration>1</duration>
			<range>1000</range>
			<!--图像------------------------------------------------------------ -->
			<meEffectImg name="earthquake_me"/>
			<stateEffectImg partType="mouth" con="add">skillEffect/dizziness</stateEffectImg>
			<description>释放一次强烈地震，使周围[range]码内的所有敌人进入眩晕状态，持续[duration]秒。</description>
			<!-- 技能各等级 ------------------------------------------------------------ -->
			<growth>
				<skill><duration>1</duration></skill>
				<skill><duration>1.6</duration></skill>
				<skill><duration>2.2</duration></skill>
				<skill><duration>2.8</duration></skill>
				<skill><duration>3.1</duration></skill>
				<skill><duration>3.3</duration></skill>
				<skill><duration>3.6</duration></skill>
				<skill><duration>3.6</duration><linkArr>earthquake_link</linkArr><changeText>同时降低目标10%的防御力</changeText><description>释放一次强烈地震，使周围[range]码内的所有敌人进入眩晕状态，同时降低目标10%的防御力，持续[duration]秒。</description></skill>
				<skill><duration>3.6</duration><ignoreImmunityB>1</ignoreImmunityB><linkArr>earthquake_link</linkArr><changeText>眩晕无视技能免疫</changeText><description>释放一次强烈地震，使周围[range]码内的所有敌人进入眩晕状态（无视技能免疫），同时降低目标10%的防御力，持续[duration]秒。</description></skill>
			</growth>
		</skill>
						<skill cnName="地震-使目标防御力降低"><!-- 生存-主动 -->
							<name>earthquake_link</name>
							<cnName>地震-使目标防御力降低</cnName>
							<!--触发条件与目标------------------------------------------------------------ -->
							<conditionType>passive</conditionType>
