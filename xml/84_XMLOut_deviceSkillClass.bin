				<skill><obj>"cnName":"闪电塔","num":1,"lifeMul":1,"dpsMul":27,"maxNum":1,"cx":0,"cy":-30,"mulByFatherB":true,"existB":false</obj></skill>
				<skill><obj>"cnName":"闪电塔","num":1,"lifeMul":1,"dpsMul":36,"maxNum":1,"cx":0,"cy":-30,"mulByFatherB":true,"existB":false</obj></skill>
